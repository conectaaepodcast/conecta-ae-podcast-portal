# Copie para .env.local e preencha (nunca commite .env.local).

# Supabase — Dashboard > Settings > API (Project URL + anon public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: novo modelo de chaves do Supabase (quando migrar do anon)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só servidor — NUNCA use prefixo NEXT_PUBLIC_. Risco extremo se vazar no bundle.
# SUPABASE_SERVICE_ROLE_KEY=

# URL canônica (SEO, Open Graph, sitemap). Em produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Página Sobre — imagem do escritório (URL https pública; opcional)
# NEXT_PUBLIC_OFFICE_IMAGE_URL=

# Tipos gerados (CLI linkada ao projeto):
# npx supabase link --project-ref <ref>
# npm run db:types
